KANAL_LOGI_SAD=1555316830770307093
KANAL_LOGI_PANSTWA=1555316830770307093
KANAL_LOGI_ANTYNUKE=1555316830770307093
# Historia zamkniętych ticketów (podsumowanie + transkrypt) - kanał tylko dla administracji
KANAL_HISTORIA_TICKETOW=1555318414791409725
# Logi usuniętych/edytowanych wiadomości (domyślnie KANAL_LOGI)
