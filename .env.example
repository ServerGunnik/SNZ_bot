# --- Role ---
# Każda zmienna ROLA_* może zawierać listę ID po przecinku (np. 111,222,333).
# Przy nadawaniu (zweryfikowany/lider/sędzia) bot nadaje wszystkie z listy;
# przy sprawdzaniu uprawnień wystarczy, że użytkownik ma dowolną z nich.
ROLA_ZWERYFIKOWANY=1555089940298207243
ROLA_STAFF=1554889408854102087
ROLA_LIDER=1555089784727281696
ROLA_SEDZIA=1555089889480155146
# Opcjonalne (domyślnie ROLA_STAFF)
ROLA_MOD_PING=
# Role, które mogą zamykać dowolne tickety (poza nimi zamyka tylko osoba, która je przyjęła).
# Właściciel serwera i technicy mają to z automatu.
ROLA_ZAMYKACZ_TICKETU=

# --- Antynuke / anty-raid ---
# Kara dla sprawcy: role (odebranie ról) | kick | ban
ANTYNUKE_KARA=role
# Zaufane ID (osoby/boty) oddzielone przecinkami; właściciel serwera jest zawsze zaufany
ANTYNUKE_WHITELIST=
# Ustaw na true, żeby wyłączyć
ANTYNUKE_WYLACZONY=false
# Nowe boty dostają rolę bez uprawnień; zmienić je może tylko właściciel (true = wyłącz blokadę)
BLOKADA_BOTOW_WYLACZONA=false
# true = boty dodane przez osoby spoza whitelisty są dodatkowo wyrzucane
ANTYNUKE_WYRZUCAJ_BOTY=false
ANTYRAID_WYLACZONY=false

# --- Automod (flood, pingi, @everyone, zaproszenia) ---
AUTOMOD_WYLACZONY=false
# Kanały bez automodu (ID oddzielone przecinkami)
AUTOMOD_POMIJANE_KANALY=

# --- Ochrona logów (usunięcie logu = odebranie rang + wyciszenie 1 h, log wraca) ---
OCHRONA_LOGOW_WYLACZONA=false

# --- Ochrona kanałów (usunięcie kanału = odebranie rang + wyciszenie 1 h) ---
OCHRONA_KANALOW_WYLACZONA=false
# false = bot nie próbuje odtwarzać usuniętego kanału (domyślnie odtwarza ze zrzutu antynuke)
OCHRONA_KANALOW_ODTWARZAJ=true

# --- Backup zwykłych wiadomości (webhook replay po odtworzeniu kanału) ---
# Bot trzyma 200 ostatnich wiadomości na każdy kanał i w razie usunięcia kanału odtwarza je
# webhookiem z nazwą i awatarem oryginalnego autora. Starsze lecą w transkrypcie .txt.
BACKUP_WIADOMOSCI_WYLACZONY=false
