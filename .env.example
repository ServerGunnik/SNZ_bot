# --- Bot ---
BOT_TOKEN=
CLIENT_ID=
GUILD_ID=
# Technik bota (ID użytkowników, oddzielone przecinkami) - alerty o usunięciu logów, przywracanie ról,
# pełne uprawnienia administracyjne w bocie (omijanie wszystkich checków jestStaff/jestLider/jestSedzia).
TECHNIK_ID=

# --- Kanały logów ---
KANAL_LOGI=
# Opcjonalne (domyślnie KANAL_LOGI)
KANAL_LOGI_TICKETY=
KANAL_LOGI_SAD=
KANAL_LOGI_PANSTWA=
KANAL_LOGI_ANTYNUKE=
# Historia zamkniętych ticketów (podsumowanie + transkrypt) - kanał tylko dla administracji
KANAL_HISTORIA_TICKETOW=
# Logi usuniętych/edytowanych wiadomości (domyślnie KANAL_LOGI)
KANAL_LOGI_WIADOMOSCI=
# Powitania nowych członków (puste = wyłączone)
KANAL_POWITANIA=

# --- Kanały modułów ---
KANAL_WERYFIKACJA=
KANAL_TICKET=
KANAL_LISTY_GONCZE=
# Wyroki z rozpraw publicznych („wyroki sądowe”). Puste = 1561390273504878632
KANAL_WYROKI=
# Wyroki z rozpraw niepublicznych („sprawy-sąd”). Puste = 1561416148019585165
KANAL_WYROKI_PRYWATNE=
# Kanał update-log z ogłoszeniami zmian w bocie (domyślnie 1536121456037990491)
KANAL_UPDATE_LOG=
KANAL_MOD_CALL=
KATEGORIA_TICKETY=
# Kategoria „Rozprawy sądowe”. Puste albo nie-kategoria = 1556035429440954468
KATEGORIA_SPRAWY=
# Kategoria na kanały narady administracji przy ticketach (domyślnie KATEGORIA_TICKETY)
KATEGORIA_NARADY=

# --- Wołanie moderatora (kanały głosowe) ---
POCZEKALNIA_ID=
POMOC_1_ID=
POMOC_2_ID=
POMOC_3_ID=

# --- Role ---
# Każda zmienna ROLA_* może zawierać listę ID po przecinku (np. 111,222,333).
# Przy nadawaniu (zweryfikowany/lider/sędzia) bot nadaje wszystkie z listy;
# przy sprawdzaniu uprawnień wystarczy, że użytkownik ma dowolną z nich.
ROLA_ZWERYFIKOWANY=
ROLA_STAFF=
ROLA_LIDER=
ROLA_SEDZIA=
# Prokurator: cooldown pozwów 10 min (zamiast 12 h) i /sprawa-prokuratora. Puste = 1563278279941554179
ROLA_PROKURATOR=
# Rangi Admin/Sędzia, które mogą zdjąć cooldown pozwu (/sprawa-cooldown); właściciel i technik zawsze.
# Puste = ROLA_SEDZIA. Lista po przecinku.
ROLA_ADMIN_SADU=
# Opcjonalne (domyślnie ROLA_STAFF)
ROLA_MOD_PING=
# Role, które mogą zamykać dowolne tickety (poza nimi zamyka tylko osoba, która je przyjęła).
# Właściciel serwera i technicy mają to z automatu.
ROLA_ZAMYKACZ_TICKETU=
# Role "junior staff" (helper/próbny admin). Dostają TYLKO: /mute, /unmute, /clear,
# /przekaz-ticket, /przekaz-wyzej oraz dostęp do kanałów ticketów i narady administracji.
# NIE mają: /ban, /unban, /panstwo, /warn, /warny, /list-gonczy-admin, /antynuke, /blok, /recru itp.
# Wyższa ranga (wg pozycji roli na serwerze) może przejąć ticket od niższej.
ROLA_HELPER=
# Role uprawnione do /ban i /unban. Jeśli puste - banować może TYLKO właściciel i technik.
# Zalecenie: wpisz tu wyższe rangi (Admin, Head Admin, Vice Owner), żeby jr admini i helperzy
# nie mogli banować. Lista po przecinku.
ROLA_BAN=

# --- Antynuke / anty-raid ---
# Kara dla sprawcy: role (odebranie ról) | kick | ban
ANTYNUKE_KARA=role
# Zaufane ID (osoby/boty) oddzielone przecinkami; właściciel serwera i technicy są zawsze zaufani
ANTYNUKE_WHITELIST=
# Ustaw na true, żeby wyłączyć
ANTYNUKE_WYLACZONY=false
# Nowe boty dostają rolę bez uprawnień; zmienić je może tylko właściciel (true = wyłącz blokadę)
BLOKADA_BOTOW_WYLACZONA=false
# true = boty dodane przez osoby spoza whitelisty są dodatkowo wyrzucane
ANTYNUKE_WYRZUCAJ_BOTY=false
ANTYRAID_WYLACZONY=false

# --- Automod (flood, pingi, @everyone, zaproszenia) ---
# Dodatkowo globalne blokady typów treści (obrazki/gify/załączniki/linki/video) ustawiasz komendą /blok
AUTOMOD_WYLACZONY=false
# Kanały bez automodu (ID oddzielone przecinkami)
AUTOMOD_POMIJANE_KANALY=

# --- Ochrona logów (usunięcie logu = odebranie rang + wyciszenie 1 h, log wraca) ---
OCHRONA_LOGOW_WYLACZONA=false

# --- Ochrona kanałów (usunięcie kanału = odebranie rang + wyciszenie 1 h) ---
# Właściciel i technik są zwolnieni - mogą usuwać dowolne kanały bez kary (tylko wpis w logach).
OCHRONA_KANALOW_WYLACZONA=false
# false = bot nie próbuje odtwarzać usuniętego kanału (domyślnie odtwarza ze zrzutu antynuke).
# Dla kanałów logów historia (200 ostatnich wiadomości) i tak wraca niezależnie od tego ustawienia.
OCHRONA_KANALOW_ODTWARZAJ=true

# --- Backup zwykłych wiadomości (webhook replay po odtworzeniu kanału) ---
# Bot trzyma 200 ostatnich wiadomości na każdy kanał i w razie usunięcia kanału odtwarza je
# webhookiem z nazwą i awatarem oryginalnego autora. Starsze lecą w transkrypcie .txt.
BACKUP_WIADOMOSCI_WYLACZONY=false
